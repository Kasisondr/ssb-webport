@@ -9,6 +9,17 @@
 #include <cstdlib>
 #include <mutex>
 #include <string>
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+EM_JS(void, local_web_persist_sram, (const char *path), {
+    try {
+        var data = FS.readFile(UTF8ToString(path));
+        var text = "";
+        for (var i = 0; i < data.length; i++) text += String.fromCharCode(data[i]);
+        localStorage.setItem("smash64.native.sram.us", btoa(text));
+    } catch (error) { console.error("Unable to persist Smash save", error); }
+});
+#endif
 
 // Where the SRAM file lives, in priority order:
 //
